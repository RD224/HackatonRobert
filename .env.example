# Server Configuration
PORT=3000

# API 1: Google Gemini Vision API (Recommended - Free & 99%+ accurate)
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# API 1 Fallback: Roboflow Inference API
# Sign up at https://roboflow.com to get your API Key
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# API 2: RapidAPI Spoonacular
# Subscribe at https://rapidapi.com/spoonacular/api/recipe-food-nutrition
RAPIDAPI_KEY=your_rapidapi_key_here

